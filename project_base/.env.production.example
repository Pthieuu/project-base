APP_PORT=8080
DB_NAME=ai_expense_manager
DB_USER=expense_app
DB_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-long-random-password


SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace-me
SMTP_PASSWORD=replace-me
PASSWORD_RESET_FROM=no-reply@example.com

# Leave empty for the bundled same-origin web client. Set one exact HTTPS
# origin only when the API is intentionally called from another web origin.
CORS_ALLOWED_ORIGIN=

# Key is stored in expense_api/.env.gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
