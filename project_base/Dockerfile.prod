FROM ghcr.io/cirruslabs/flutter:3.41.6 AS flutter-build

WORKDIR /src
COPY pubspec.yaml pubspec.lock ./
RUN flutter pub get
COPY lib ./lib
COPY web ./web
COPY analysis_options.yaml ./
RUN flutter build web --release --dart-define=API_BASE_URL=/api/

FROM composer:2.8 AS composer-build

WORKDIR /app
COPY expense_api/composer.json expense_api/composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --classmap-authoritative

FROM php:8.3-fpm-bookworm AS api

RUN apt-get update \
    && apt-get install -y --no-install-recommends libcurl4-openssl-dev \
    && docker-php-ext-install curl mysqli \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www
COPY expense_api ./expense_api
COPY --from=composer-build /app/vendor ./expense_api/vendor

USER www-data

FROM nginx:1.28-alpine AS web

COPY --from=flutter-build /src/build/web /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
