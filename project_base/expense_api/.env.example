# MySQL chạy local bằng XAMPP
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_expense_manager
DB_USER=root
# Điền mật khẩu MySQL; để trống nếu tài khoản root local không có mật khẩu
DB_PASSWORD=


# Key is stored in expense_api/.env.gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_VISION_MODEL=gemini-3.5-flash-lite
